DATABASE_URL=postgresql+asyncpg://loretrace:loretrace@localhost:5432/loretrace

# Override in production, this default is dev-only
SECRET_KEY=dev-secret-change-me

# Required for /chat, no default. Free key at console.groq.com
GROQ_API_KEY=

# Consumed only by scripts/seed_super_admin.py to create the first admin
# account. Not needed at request time, safe to leave blank otherwise.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
